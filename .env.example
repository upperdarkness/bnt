# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blacknova
DB_USER=bnt
DB_PASS=bnt

# Security
# Generate a secure admin password hash using: php -r "echo password_hash('your_password', PASSWORD_DEFAULT);"
# Then update config/config.php with the hash

# Alignment / NPC framework (see docs/ALIGNMENT_AND_NPCS.md)
# ALIGNMENT_ENABLED=true
# NPC_ENABLED=true
# NPC_LLM_ENABLED=false
# NPC_DEFAULT_MODEL=
# NPC_DAILY_BUDGET_USD=1.00
# NPC_GLOBAL_DAILY_BUDGET_USD=10.00
# NPC_WORKER_IPS=127.0.0.1,::1
# NPC_ALERT_EMAIL=

# LLM worker only (put these in the worker's own environment file, never in the repository):
# OPENROUTER_API_KEY=
# NPC_TOKENS_FILE=/etc/bnt/npc_tokens.json
# NPC_API_BASE_URL=https://your-game.example.com/api/v1

# Newbie protection, the Galactic Courier and rumours
# PROTECTION_ENABLED=true
# NEWS_JOURNALIST_ENABLED=false
# NEWS_REVIEW_MODE=true
# RUMOURS_ENABLED=false
